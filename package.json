{
  "name": "firsthand-ssr",
  "private": true,
  "type": "module",
  "description": "A small reading list, rendered on a server and adopted by the browser.",
  "scripts": {
    "dev": "node server/main.mjs",
    "build": "vite build --outDir dist/client && vite build --ssr src/app/entry-server.tsx --outDir dist/server",
    "start": "NODE_ENV=production node server/main.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firsthandjs/data": "^0.12.2",
    "@firsthandjs/dom": "^0.12.2",
    "@firsthandjs/server": "^0.12.2"
  },
  "devDependencies": {
    "@firsthandjs/compiler": "^0.12.2",
    "@firsthandjs/jsx-runtime": "^0.12.2",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
