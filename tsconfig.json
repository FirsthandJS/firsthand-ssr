{
  "compilerOptions": {
    // `@/` is `src/`, so an import says where a thing lives rather than how
    // many folders up it is from here.
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "jsxImportSource": "@firsthandjs/jsx-runtime"
  },
  "include": ["src", "*.ts"]
}
